# ==============================================================================
# Omnichannel Marketing ROI & Attribution Engine - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual configuration:
#   cp .env.example .env
# ==============================================================================

# Google Cloud Platform Configuration
GCP_PROJECT_ID=globalretail-analytics-prod
GCP_REGION=us-central1
GCS_BUCKET_NAME=globalretail-marketing-lake-raw
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# BigQuery Dataset Names
BQ_RAW_DATASET=raw
BQ_STAGING_DATASET=staging
BQ_INTERMEDIATE_DATASET=intermediate
BQ_MARTS_DATASET=marts

# Synthetic Data Generation Configuration
DATA_GEN_SEED=42
DATA_GEN_START_DATE=2024-01-01
DATA_GEN_END_DATE=2025-12-31
ANNUAL_ACQUISITION_BUDGET=40000000

# Airflow Local Docker Setup
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.2-python3.11
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
